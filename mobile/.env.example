# URL base da API REST consumida pelo app.
# Padrão (se não definir): http://localhost:3000  (usado com `adb reverse` no emulador Android)
#
# Exemplos:
#   Emulador Android sem adb reverse:  http://10.0.2.2:3000
#   Celular físico (mesma rede Wi-Fi): http://192.168.0.10:3000
#   Back-end publicado:                https://meu-backend.exemplo.com
EXPO_PUBLIC_API_URL=http://localhost:3000
